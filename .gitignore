.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# Databases & local data stores
*.db
*.db-journal
*.sqlite
*.sqlite3
orca_marine.db

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

