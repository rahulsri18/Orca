# ==============================================================================
# ORCA 2.0 - Oceanic Risk Calculation & Advisory Platform
# Environment Configuration Template
# ==============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database Settings
# For SQLite (default development):
DATABASE_URL=sqlite:///./orca_marine.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://orca_user:secure_password@localhost:5432/orca_marine_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Automated Background Refresh Engine
DATA_REFRESH_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3

# External Marine & Weather API Configuration
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine
IMD_MAUSAM_BASE_URL=https://mausam.imd.gov.in
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap

# Frontend Configuration (for production deployment)
# Leave empty for local development (uses Vite proxy). In production, set to your backend URL:
# VITE_API_BASE_URL=https://orca-backend.onrender.com
VITE_API_BASE_URL=

# AI Multi-Agent Coordinator Settings (Optional)
# If provided, enables natural synthesis via Google Gemini; otherwise deterministic multi-agent synthesis is used.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Official Agency Institutional Access Tokens (Optional / Restricted)
# Required for direct authenticated ingestion from SAC/ISRO MOSDAC or VEDAS FTP/WMS services:
MOSDAC_USER_TOKEN=
VEDAS_ACCESS_KEY=
